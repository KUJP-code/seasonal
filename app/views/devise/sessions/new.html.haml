%main.auth-page
  #login
    = render 'shared/splash_image', avif: @avif, fallback: @fallback
    = form_for resource,
               as: resource_name,
               url: session_path(resource_name),
               html: { id: 'action-pane', data: { turbo: false } } do |f|

      .auth-brand
        = image_tag 'kidsup-auth-logo.svg', alt: 'Kids UP', width: 140, height: 43
      .form-floating.auth-email
        = f.email_field :email, class: 'form-control bs-info',
                                autofocus: true,
                                placeholder: t('.email'),
                                required: true
        = f.label :email, t('.email'), class: 'form-label'
        .invalid-feedback= t('.enter_email')

      .form-floating.auth-password
        = f.password_field :password, class: 'form-control',
                                      autocomplete: 'current-password',
                                      required: true,
                                      placeholder: resource.class.human_attribute_name(:password)
        = f.label :password, class: 'form-label'
        .invalid-feedback= t('.enter_pwd')

      #reset-pass
        = link_to t('.forgot_password'), new_password_path(resource_name)

      - if devise_mapping.rememberable?
        .form-check.auth-remember
          = f.check_box :remember_me, class: 'form-check-input'
          = f.label :remember_me, t('.remember'), class: 'form-check-label'

      .auth-actions
        = f.submit t('.login'), class: 'btn btn-primary auth-submit'
        = link_to t('.sign_up'),
                  new_registration_path(resource_name),
                  class: 'btn auth-register'
