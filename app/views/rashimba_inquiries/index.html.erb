<main id="rashimba-inquiries">
  <div class="card p-3 mb-3">
    <h2>Rashimba Inquiries</h2>
    <nav class="nav nav-pills gap-2 mb-3" aria-label="Inquiry types">
      <% [['All', nil], *RashimbaInquiry::KINDS.to_a].each do |label, kind| %>
        <%= link_to label, rashimba_inquiries_path(kind: kind), class: "nav-link #{'active' if params[:kind].presence == kind}" %>
      <% end %>
    </nav>
    <%= form_with url: rashimba_inquiries_path, method: :get, class: 'd-flex gap-2 flex-wrap', local: true do |f| %>
      <%= f.hidden_field :kind, value: params[:kind] %>
      <%= f.label :q, 'Name, company or email', class: 'visually-hidden' %>
      <%= f.search_field :q, value: params[:q], placeholder: 'Name, company or email', class: 'form-control w-auto', maxlength: 200 %>
      <%= f.label :status, 'Status', class: 'visually-hidden' %>
      <%= f.select :status, options_for_select([['All statuses', '']] + RashimbaInquiry.statuses.keys.map { |status| [status.humanize, status] }, params[:status]), {}, class: 'form-select w-auto' %>
      <%= f.submit 'Filter', class: 'btn btn-primary' %>
    <% end %>
  </div>

  <%= paginate @rashimba_inquiries %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-primary">
        <tr><th>Received</th><th>Type</th><th>Name / company</th><th>Email</th><th>Status</th><th>Emails</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% @rashimba_inquiries.each do |inquiry| %>
          <tr>
            <td><%= l(inquiry.created_at, format: :short) %></td>
            <td><%= inquiry.kind_label %></td>
            <td><%= [inquiry.name, inquiry.company].compact_blank.join(' / ').presence || '-' %></td>
            <td><%= inquiry.email %></td>
            <td><%= inquiry.status.humanize %></td>
            <td><%= inquiry.confirmation_sent_at && inquiry.notification_sent_at ? 'Sent' : 'Pending / retrying' %></td>
            <td class="d-flex gap-2">
              <%= link_to 'View', rashimba_inquiry_path(inquiry), class: 'btn btn-sm btn-primary' %>
              <%= button_to 'Delete', rashimba_inquiry_path(inquiry), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: 'Permanently delete this inquiry?' } } %>
            </td>
          </tr>
        <% end %>
        <% if @rashimba_inquiries.empty? %>
          <tr><td colspan="7">No inquiries found.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= paginate @rashimba_inquiries %>
</main>
